# Production build values for the penumbrafi deployment.
#
# CI does not read this file: .github/workflows/deploy.yml writes ./.env from
# the repository variables of the same name so the domain can be switched
# without a code change. It is kept as the documented reference and for local
# production-style builds (`env-cmd -f .env.penumbrafi next build`).
#
# explorer.rotko.net stays as an alias of explorer.penumbra.fi.
BASE_URL=https://explorer.penumbra.fi
NEXT_PUBLIC_APP_VERSION=1.7.0
NEXT_PUBLIC_ENV_NAME=prod
NEXT_PUBLIC_GRAPHQL_HOST=api.explorer.penumbra.fi
NO_INDEX=false
